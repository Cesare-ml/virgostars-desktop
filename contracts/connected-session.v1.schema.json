{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virgostars.it/contracts/connected-session.v1.schema.json",
  "title": "Verified desktop connected session v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "status", "scope", "profileRef"],
  "properties": {
    "contractVersion": { "const": 1 },
    "status": { "const": "active" },
    "scope": { "enum": ["chart_sync:read", "chart_sync:read chart_sync:groups:write", "chart_sync:read chart_sync:charts:write", "chart_sync:read chart_sync:groups:write chart_sync:charts:write"] },
    "profileRef": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
  }
}
