{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virgostars.it/contracts/connected-account-status.v1.schema.json",
  "title": "Connected account status v1: read-only connection",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "status", "attemptId", "scope"],
  "properties": {
    "protocolVersion": { "const": 1 },
    "status": { "const": "connected" },
    "attemptId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "scope": { "const": "chart_sync:read" }
  }
}
