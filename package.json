{
  "name": "virgostars-desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Private experimental VirgoStars desktop Angular workstation with real Astrological Charts renderer",
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:ai:fixture": "node --experimental-strip-types --test tests/copilot-staging-fixture.test.mjs",
    "test:ai:types": "tsc --noEmit --strict --target ES2022 --module ES2022 --moduleResolution bundler --allowImportingTsExtensions src/app/native/copilot-staging-transport.ts",
    "check": "npm run test && npm run build:ui",
    "prepare:frontend": "node scripts/prepare-synthetic-frontend.mjs",
    "prepare:icon": "node scripts/generate-spike-icon.mjs",
    "start": "npm run prepare:frontend && ng serve desktop --host 127.0.0.1 --port 4200",
    "build:ui": "npm run prepare:frontend && ng build desktop && npm run verify:bundle",
    "tauri:dev": "npm run prepare:icon && tauri dev",
    "tauri:build": "npm run build:ui && npm run prepare:icon && tauri build",
    "verify:bundle": "node scripts/verify-offline-bundle.mjs",
    "doctor": "node scripts/desktop-doctor.mjs --stage=setup",
    "doctor:json": "node scripts/desktop-doctor.mjs --stage=setup --json",
    "doctor:build": "node scripts/desktop-doctor.mjs --stage=build --strict",
    "doctor:verify": "node scripts/desktop-doctor.mjs --stage=verify --strict",
    "verify:css": "node scripts/verify-bundled-css.mjs"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.3.5",
    "@angular/cli": "20.3.5",
    "@angular/compiler-cli": "20.3.35",
    "@tauri-apps/cli": "2.12.2",
    "@types/three": "0.170.0",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "dependencies": {
    "@angular/common": "20.3.35",
    "@angular/core": "20.3.35",
    "@angular/compiler": "20.3.35",
    "@angular/platform-browser": "20.3.35",
    "grafici-astrologici": "file:../astrological-charts/dist/grafici-astrologici",
    "gsap": "^3.12.5",
    "moment-timezone": "^0.5.46",
    "rxjs": "^7.8.0",
    "three": "0.170.0",
    "tslib": "^2.8.1",
    "@tauri-apps/api": "2.12.2"
  }
}
