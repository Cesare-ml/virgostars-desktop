{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "desktop": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "styles": [
              "src/styles.css"
            ],
            "tsConfig": "tsconfig.app.json",
            "outputPath": "dist/desktop",
            "assets": [
              {
                "glob": "**/*",
                "input": ".local/frontend/assets",
                "output": "assets"
              }
            ],
            "optimization": {
              "scripts": true,
              "styles": {
                "minify": true,
                "inlineCritical": false
              },
              "fonts": false
            },
            "subresourceIntegrity": false
          },
          "configurations": {
            "private-artwork": {
              "assets": [
                {
                  "glob": "**/*",
                  "input": ".local/frontend-private/assets",
                  "output": "assets"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/app/asset-mode.ts",
                  "with": "src/app/asset-mode.private.ts"
                },
                {
                  "replace": "src/app/monomeri-data.ts",
                  "with": ".local/monomeri-data.private.ts"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "desktop:build"
          }
        }
      }
    }
  }
}
